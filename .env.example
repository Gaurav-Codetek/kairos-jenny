# ── App ──────────────────────────────────────────────────────────────
APP_NAME=Kairos
APP_ENV=dev
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-in-production

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kairos:kairos_dev@db:5432/kairos

# ── Databricks ───────────────────────────────────────────────────────
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net
DATABRICKS_TOKEN=<your-personal-access-token>
DATABRICKS_SQL_WAREHOUSE_ID=<your-sql-warehouse-id>
DATABRICKS_JOBS_API_VERSION=2.2
DATABRICKS_WORKSPACE_API_VERSION=2.0
DATABRICKS_SQL_API_VERSION=2.0
DATABRICKS_UNITY_CATALOG_API_VERSION=2.1
DATABRICKS_REQUEST_TIMEOUT_SECONDS=30
DATABRICKS_STATEMENT_TIMEOUT_SECONDS=300

# ── LLM service ─────────────────────────────────────────────────────
# nebius = NVIDIA Nemotron on Nebius Token Factory (the settings further down; what the hackathon build runs on);
# azure = Azure AI Foundry; openai = the OpenAI API platform.
LLM_PROVIDER=nebius
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ── Azure OpenAI (LLM_PROVIDER=azure) ───────────────────────────────
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# ── NVIDIA Nemotron on Nebius Token Factory (LLM_PROVIDER=nebius / COMPANION_LLM=nebius) ──
# Check the key and the model ids first:  python -m kairos_kb.llm.nebius_check
NEBIUS_API_KEY=<your-nebius-token-factory-key>
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Heavy reasoning (enrichment, data products, RCA, evals)
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
# Jenny's spoken turns (fast first word)
NEBIUS_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
# Jenny's model: nebius:<model id>, nebius (= NEBIUS_FAST_MODEL), a Gemini model id, or azure (= LLM_PROVIDER).
# Super-VL keeps every spoken number tied to what its lookup covered; Lightning is faster but less reliable on that.
COMPANION_LLM=nebius:nvidia/Nemotron-3.5-Super-VL
# Embeddings: empty follows LLM_PROVIDER, except nebius, which keeps azure (the stored vectors were made there)
# EMBEDDING_PROVIDER=

# ── Snowflake (the warehouse Kairos maps; add the connection on the Connections screen) ──
# Authenticate with ONE of: a programmatic access token, a key pair, or a password.
# SNOWFLAKE_ACCOUNT=<org-account>
# SNOWFLAKE_USER=<user>
# SNOWFLAKE_TOKEN=<programmatic-access-token>
# SNOWFLAKE_WAREHOUSE=<warehouse>
# SNOWFLAKE_ROLE=<role>

# ── Tavily (Jenny's weather_news tool: weather news for a city that might affect deliveries) ──
# Bound to weather, and offered only when a question is about the weather. 1 (with a key) turns it on.
JENNY_WEB_SEARCH=1
TAVILY_API_KEY=<your-tavily-key>
# TAVILY_DAYS=3

# ── LangSmith ────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=<your-langsmith-api-key>
LANGCHAIN_PROJECT=kairos-dev

# ── Local Storage ────────────────────────────────────────────────────
STORAGE_BASE_PATH=./data

# ── Sync Settings ────────────────────────────────────────────────────
SYNC_DEFAULT_RUN_HISTORY_LIMIT=25
SYNC_INITIAL_LOOKBACK_HOURS=24

# ── TypeSafe Jev (experimental "Run JEV RCA") ───────────────────────
TYPESAFE_API_KEY=<your-typesafe-api-key>
# Optional: pin a versioned model ID; empty = jev-latest
TYPESAFE_MODEL=
JEV_RCA_CONFIDENCE_THRESHOLD=0.6

# ── Context layer ────────────────────────────────────────────────────
# Embedding deployment for meaning-based search (empty = keyword search only).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Agent access to MCP and the context API: off | optional | required.
AGENT_AUTH_MODE=optional
PUBLIC_API_URL=http://localhost:8888

# Public hostnames the MCP endpoint accepts (tunnel or domain), comma-separated.
MCP_ALLOWED_HOSTS=

# Jenny's voice: ElevenLabs when a key is set (Kokoro, the open-source voice service, otherwise and as fallback)
ELEVENLABS_API_KEY=
# A voice name from your ElevenLabs library, or its id
JENNY_ELEVEN_VOICE=Alisha
JENNY_ELEVEN_MODEL=eleven_v4_turbo
# Optional accent for Jenny's ElevenLabs voice, e.g. Indian English
JENNY_ACCENT=
# Jack (ElevenLabs Agent experiment): needs the key's ElevenLabs Agents permission
JACK_ENABLED=0
JACK_LLM=gemini-2.5-flash
JACK_VOICE=Raju

# Optional: Gemini as Jenny's model instead (COMPANION_LLM=gemini-3.5-flash)
GEMINI_API_KEY=
# Seconds before her backup request is sent if the first hasn't started answering
COMPANION_HEDGE_S=2.5
